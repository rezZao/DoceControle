<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DoceControle.Api</RootNamespace>
    <!-- O programa gerado se chama DoceControle.exe e usa o ícone da marca. -->
    <AssemblyName>DoceControle</AssemblyName>
    <ApplicationIcon>icone.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Dados\alimentos.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
